# ── apps/api environment ──────────────────────────────────────────────────
# Copy to apps/api/.env and fill in real values. NEVER commit the real .env.

# Node environment: development | production | test
NODE_ENV=development

# Port the API listens on (default 3333)
PORT=3333

# Comma-separated list of allowed CORS origins (the web app's URL).
# Example for local dev:
CORS_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL) ──────────────────────────────────────────────────
# Matches docker-compose.yml defaults. Change credentials for production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ranin?schema=public"

# ── Auth / JWT ─────────────────────────────────────────────────────────────
# Generate strong, unique secrets, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
REFRESH_JWT_SECRET=change-me-to-a-different-long-random-string
REFRESH_JWT_EXPIRES_IN=30d

# ── Object storage ─────────────────────────────────────────────────────────
# Use "vercel-blob" for Vercel previews; Liara remains the VPS/default path.
UPLOAD_PROVIDER=liara
LIARA_ENDPOINT=https://storage.iran.liara.space
LIARA_BUCKET_NAME=your-bucket-name
LIARA_ACCESS_KEY=your-access-key
LIARA_SECRET_KEY=your-secret-key
