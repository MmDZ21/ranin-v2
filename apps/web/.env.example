# ── apps/web environment ──────────────────────────────────────────────────
# Copy to apps/web/.env and fill in real values. NEVER commit the real .env.

# Node environment: development | production | test
NODE_ENV=development

# Public site origin, used for canonical URLs, sitemap, robots, and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API base URL used by SERVER-side code (middleware, server actions).
# Not exposed to the browser. Include the /api prefix.
BACKEND_URL=http://localhost:3333/api

# API base URL used by CLIENT-side code (browser fetches). Exposed to the
# browser bundle, so it must be a publicly reachable URL in production.
NEXT_PUBLIC_API_URL=http://localhost:3333/api

# Optional artificial delay (ms) for client fetches during development.
NEXT_PUBLIC_API_DELAY_MS=0

# Secret used to sign the session cookie (jose / HS256). MUST be strong.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET_KEY=change-me-to-a-long-random-string
